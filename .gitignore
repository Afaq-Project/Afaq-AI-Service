# --------------------------------------------
# Python cache & compiled files
# --------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
dist/
build/
*.whl

# --------------------------------------------
# Poetry (إدارة البيئة والمكتبات)
# --------------------------------------------
# لا ترفع البيئة الافتراضية التي ينشئها Poetry
.venv/
venv/
env/

# لكن احتفظ بـ poetry.lock لضمان تحديد الإصدارات
# (إذا كنت تريد تجاهل poetry.lock في مشاريع المكتبات، لكن في مشاريع التطبيقات يُفضل الاحتفاظ به)
# !poetry.lock

# --------------------------------------------
# متغيرات البيئة والملفات الحساسة (SECURITY)
# --------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets.yaml

# --------------------------------------------
# أدوات التطوير والتحرير
# --------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
*.log
*.tmp

# --------------------------------------------
# التقارير والملفات المؤقتة
# --------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
*.pyre/

# --------------------------------------------
# قاعدة البيانات المحلية (إن وجدت)
# --------------------------------------------
*.db
*.sqlite
*.sqlite3

.agent/
Python_Service/
