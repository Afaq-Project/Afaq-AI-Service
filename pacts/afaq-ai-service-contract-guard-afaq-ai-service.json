{
  "consumer": {
    "name": "afaq-ai-service-contract-guard"
  },
  "provider": {
    "name": "afaq-ai-service"
  },
  "interactions": [
    {
      "description": "health endpoint reports database connectivity",
      "providerState": "database is healthy",
      "request": {
        "method": "GET",
        "path": "/health"
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body": {"status": "ok", "database": "connected"}
      }
    },
    {
      "description": "security endpoint inspects a safe URL",
      "providerState": "safe URL validation result is available",
      "request": {
        "method": "POST",
        "path": "/api/v1/security/inspect-url",
        "headers": {"Content-Type": "application/json", "X-API-Key": "pact-test-key"},
        "body": {"url": "https://example.edu/scholarships", "allow_redirects": true}
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body": {
          "status": "success",
          "data": {
            "original_url": "https://example.edu/scholarships",
            "canonical_url": "https://example.edu/scholarships",
            "scheme": "https",
            "host": "example.edu",
            "port": 443,
            "resolved_ip": "203.0.113.10",
            "is_https": true,
            "redirect_hops": 0,
            "redirect_chain": [],
            "dns_pinned_rule": "MAP example.edu 203.0.113.10"
          },
          "message": "URL verified as safe."
        }
      }
    },
    {
      "description": "webhook receiver acknowledges scrape completion",
      "providerState": "valid API key and scrape completion payload",
      "request": {
        "method": "POST",
        "path": "/api/v1/webhook/scrape-complete",
        "headers": {"Content-Type": "application/json", "X-API-Key": "pact-test-key"},
        "body": {
          "batch_id": "batch-contract-001",
          "total_opportunities": 2,
          "succeeded_sources": ["https://example.edu"],
          "failed_sources": []
        }
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body": {"status": "received", "batch_id": "batch-contract-001"}
      }
    },
    {
      "description": "scrape run accepts a source and returns an operation identifier",
      "providerState": "source is available and operation can be queued",
      "request": {
        "method": "POST",
        "path": "/api/v1/scrape/run",
        "headers": {
          "Content-Type": "application/json",
          "X-API-Key": "pact-test-key",
          "Idempotency-Key": "33333333-3333-4333-8333-333333333333"
        },
        "body": {"source_ids": ["22222222-2222-4222-8222-222222222222"]}
      },
      "response": {
        "status": 202,
        "headers": {"Content-Type": "application/json"},
        "body": {
          "status": "accepted",
          "operation_id": "11111111-1111-4111-8111-111111111111",
          "sources_queued": 1,
          "sources_skipped_locked": 0,
          "message": "Scrape operation started in background; a webhook notification will be dispatched on completion."
        }
      }
    },
    {
      "description": "operations endpoint returns a paginated operation log",
      "providerState": "operation log is empty",
      "request": {
        "method": "GET",
        "path": "/api/v1/scrape/operations",
        "headers": {"X-API-Key": "pact-test-key"},
        "query": {"limit": "10", "offset": "0"}
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body": {
          "status": "success",
          "data": {"total_count": 0, "limit": 10, "offset": 0, "operations": []},
          "message": "Operations log retrieved successfully."
        }
      }
    },
    {
      "description": "latest operation endpoint reports no operation when the log is empty",
      "providerState": "no scrape operations exist",
      "request": {
        "method": "GET",
        "path": "/api/v1/scrape/operations/latest",
        "headers": {"X-API-Key": "pact-test-key"}
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body": {
          "status": "success",
          "data": null,
          "message": "No scraping operations have been executed yet."
        }
      }
    },
    {
      "description": "operation endpoint returns operation status and telemetry",
      "providerState": "completed operation exists",
      "request": {
        "method": "GET",
        "path": "/api/v1/scrape/operations/11111111-1111-4111-8111-111111111111",
        "headers": {"X-API-Key": "pact-test-key"}
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body": {
          "status": "success",
          "data": {
            "operation_id": "11111111-1111-4111-8111-111111111111",
            "status": "completed",
            "is_currently_active": false,
            "triggered_by": "admin_api",
            "sources_attempted": ["22222222-2222-4222-8222-222222222222"],
            "sources_succeeded": ["22222222-2222-4222-8222-222222222222"],
            "sources_failed": [],
            "total_listings_found": 2,
            "total_details_extracted": 2,
            "total_files_downloaded": 1,
            "error_summary": {}
          },
          "message": "Operation status retrieved successfully."
        }
      }
    },
    {
      "description": "abort endpoint confirms operation cancellation and lock release",
      "providerState": "running operation exists with one source lock",
      "request": {
        "method": "POST",
        "path": "/api/v1/scrape/operations/11111111-1111-4111-8111-111111111111/abort",
        "headers": {"X-API-Key": "pact-test-key"}
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body": {
          "status": "success",
          "data": {
            "operation_id": "11111111-1111-4111-8111-111111111111",
            "status": "aborted",
            "sources_released": 1,
            "message": "Scrape operation aborted successfully. All acquired source locks have been released."
          },
          "message": "Operation aborted."
        }
      }
    },
    {
      "description": "source abort confirms selective cancellation and lock release",
      "providerState": "source is currently locked by a scrape operation",
      "request": {
        "method": "POST",
        "path": "/api/v1/scrape/sources/22222222-2222-4222-8222-222222222222/abort",
        "headers": {"X-API-Key": "pact-test-key"}
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body": {
          "status": "success",
          "data": {
            "source_id": "22222222-2222-4222-8222-222222222222",
            "is_locked": false,
            "status": "aborted",
            "message": "Source crawl halted successfully. Lock released."
          },
          "message": "Source halted."
        }
      }
    },
    {
      "description": "source onboarding returns discovered portal configuration",
      "providerState": "valid educational portal is reachable and source configuration is discovered",
      "request": {
        "method": "POST",
        "path": "/api/v1/scrape/sources/onboard",
        "headers": {"Content-Type": "application/json", "X-API-Key": "pact-test-key"},
        "body": {"url": "https://example.edu/scholarships", "name": "Example Scholarships"}
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body": {
          "status": "success",
          "data": {
            "source_id": "22222222-2222-4222-8222-222222222222",
            "domain": "example.edu",
            "site_name": "Example Scholarships",
            "supported_languages": ["en"],
            "pagination_type": "url_param",
            "pagination_config": {"param": "page", "step": 1},
            "ordering_strategy": "chronological_descending",
            "rate_limit_delay_sec": 1.0,
            "is_active": true
          },
          "message": "Source onboarded and technical configuration populated successfully."
        }
      }
    },
    {
      "description": "dead letter endpoint returns a paginated listing failure queue",
      "providerState": "dead letter queue is empty",
      "request": {
        "method": "GET",
        "path": "/api/v1/scrape/dead-letter",
        "headers": {"X-API-Key": "pact-test-key"},
        "query": {"entity_type": "listings", "limit": "10", "offset": "0"}
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body": {
          "status": "success",
          "data": {"total_count": 0, "entity_type": "listings", "items": []},
          "message": "Dead letter items retrieved successfully."
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {"version": "2.0.0"}
  }
}
