DATABASE_URL=postgresql://user:password@host:5432/levora_python
API_KEY_HEADER_NAME=X-API-Key
MAIN_SERVICE_WEBHOOK_URL=http://localhost:3000/api/webhooks/scrape-complete
MAIN_SERVICE_WEBHOOK_SECRET=change_me
LOG_LEVEL=INFO
ENVIRONMENT=development

ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=1
AI_CHAT_MAX_TOKENS=4096
AI_REVIEW_MAX_TOKENS=8192
AI_HISTORY_LIMIT=20
AI_REFUSAL_FALLBACKS=true
